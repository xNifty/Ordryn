# Development .env template for Cloud Agent (copied to repo-root .env by install.sh).
# The real .env is git-ignored; edit this template to change local defaults.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gotodo
SESSION_KEY=dev-session-key-for-cloud-agent-0123456789
REDIS_URL=redis://localhost:6379/0

PORT=8080
GOTODO_MODE=full
BASE_PATH=/
USE_HTTPS=false

# First-boot bootstrap admin (idempotent) so the SPA can be exercised end to end.
GOTODO_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
GOTODO_BOOTSTRAP_ADMIN_PASSWORD=devpassword123
GOTODO_BOOTSTRAP_ENABLE_API=true
